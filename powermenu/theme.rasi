* {
    font: "Monospace 13";

    nordicBlue: #2D3440;
    nordicBlueLight: #3A4250;

    white: #bbaa99;
    whiteLight: #ddccbb;

    // Bold, Italic, Underline
    highlight: bold #ffffff;

    background-color: @nordicBlue;
    text-color: #ffeedd;

    margin: 0;
    padding: 10px;
    spacing: 0;
}

window {
    height: 370px;
    width: 320px;
    location: center;
    anchor: center;
    border:  0px 0px 0px 0px;
    text-color: @whiteLight;
    border-radius: 15px;
}

inputbar {
    background-color: @nordicBlue;
    padding: 5px;
    border: 4px 4px 4px 4px;
    border-color: @nordicBlueLight;
    border-radius: 10px;
}

mainbox {
    spacing: 0;
    children: [ listview ];
}

listview {
    padding: 1em 1em 1em 1em;
    dynamic: false;
    spacing: 10px;
    lines: 5;
    columns: 1;
    fixed-columns: true;
}

element {
    border-radius: 10px;
}

element selected normal {
    background-color: @nordicBlueLight;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text selected normal {
    background-color: @nordicBlueLight;
}
